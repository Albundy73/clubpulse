# PostgreSQL connection string shared by ClubPulse web and ingestion jobs.
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clubpulse?sslmode=require"
DATABASE_URL=""

# Secret used by Vercel Cron. Vercel sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# Optional separate secret for manual/on-demand ingestion requests.
INGEST_SECRET=""
